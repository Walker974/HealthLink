# These values are public browser configuration, never secrets.
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=healthlink
VITE_KEYCLOAK_CLIENT_ID=healthlink-web
# Allows explicitly labelled sample screens at /?preview=1; never grants API access.
VITE_ENABLE_DESIGN_PREVIEW=true
# Vite server only; this is not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8080
