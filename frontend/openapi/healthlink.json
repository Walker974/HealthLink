{"openapi":"3.1.0","info":{"title":"HealthLink API","description":"Public imaging availability and authorized hospital management. Citizen searches and organization reference reads are public. Protected operations require a Keycloak access token and the documented role; hospital and department boundaries are enforced by the services.","version":"0.0.1-SNAPSHOT"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Equipment","description":"Public availability searches, equipment registration and fault reporting"},{"name":"Staff","description":"Link existing Keycloak users to local staff assignments and inspect your profile"},{"name":"Organization","description":"Regions, public hospitals and hospital departments"},{"name":"Audit","description":"Append-only operational history, with server-resolved actor identities"},{"name":"Maintenance","description":"Versioned fault reports, assigned repairs and independent verification"}],"paths":{"/api/work-orders":{"get":{"tags":["Maintenance"],"summary":"List work orders for equipment","description":"Scoped staff access. Newest reports first. Page is zero-based; size must be 1–100.","operationId":"list","parameters":[{"name":"equipmentId","in":"query","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Maintenance"],"summary":"Report a fault and open a work order","description":"RADIOLOGY_OPERATOR, own department. Submit the current equipmentVersion from GET /api/e